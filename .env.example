# Supabase — new project dedicated to the CRM (no shared DB with the website)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: users admin, inbound endpoint, seed scripts. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL (password reset redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Inbound leads HMAC secret shared with the website (see docs/INBOUND-LEADS.md)
INBOUND_LEADS_SECRET=generate-a-long-random-secret

# Email module: 32 random bytes in base64, e.g. `openssl rand -base64 32`.
# Server only. Changing this value invalidates every saved mailbox password.
# EMAIL_CREDENTIALS_KEY=

# First profile with this email is promoted to super_admin (bootstrap only)
# CRM_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Require AAL2 (MFA) for every CRM session once MFA is enrolled
# CRM_REQUIRE_MFA=true

# scripts/create-admin-user.mjs — never commit a real password
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# RLS tests (npm run test:rls) — a disposable Supabase TEST project, never production
# RLS_TEST_SUPABASE_URL=
# RLS_TEST_ANON_KEY=
# RLS_TEST_SERVICE_ROLE_KEY=

# scripts/seed-demo.mjs — password for the demo users it creates
# DEMO_PASSWORD=

# scripts/seed-demo.mjs — demo/test projects ONLY (creates users with a shared password)
# The script refuses to run unless SEED_ALLOW=1 and SEED_PROJECT_REF equals the
# <ref> in NEXT_PUBLIC_SUPABASE_URL (https://<ref>.supabase.co; local stack: 127.0.0.1).
# SEED_ALLOW=1
# SEED_PROJECT_REF=
# SEED_CREATE_ADMIN=1
# DEMO_PASSWORD=
# DEMO_EMAIL_DOMAIN=example.com
